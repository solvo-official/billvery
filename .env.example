# --- Database (PostgreSQL 15+) --------------------------------------------------------------
# Any PostgreSQL URL works as printed by the provider, including Neon's
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# sslmode is translated for asyncpg (require/verify-* verify the certificate), and a `-pooler`
# host is detected: prepared-statement caching is switched off for PgBouncer automatically.
DATABASE_URL=postgresql+asyncpg://invoice_auditor:change-me@localhost:5432/invoice_auditor
# Optional direct (non-pooled) endpoint; `invoice-auditor migrate` prefers it. Neon's Vercel
# integration sets this for you.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# auto: no connection pool when VERCEL=1 (one connection per request), a pool otherwise.
DB_POOL=auto
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_S=15
DB_STATEMENT_TIMEOUT_MS=15000

# --- Browser sign-in (Google OAuth) ----------------------------------------------------------
# Signs the session cookie; at least 32 characters:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_TTL_HOURS=12
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console > APIs & Services >
# Credentials. Authorized redirect URI: <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the console, used for that redirect URI. On Vercel it defaults to the
# production domain; locally set it to the Vite dev server (http://localhost:5173).
# PUBLIC_URL=https://invoice-auditor.vercel.app

# --- Gemini extraction (needed for POST /api/v1/invoices/upload and `invoice-auditor extract`) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_S=120
GEMINI_MAX_ATTEMPTS=3

# --- Uploaded originals (content-addressed per tenant) ---------------------------------------
# auto: in the database when VERCEL=1 (a function's file system isn't durable), on disk otherwise.
DOCUMENT_STORAGE=auto
DOCUMENT_STORAGE_DIR=data/documents
# Defaults to 18 MB, or 4 MB on Vercel (its functions refuse request bodies over 4.5 MB).
# MAX_UPLOAD_BYTES=18874368

# --- Anomaly rule thresholds (defaults shown) -----------------------------------------------
DUPLICATE_WINDOW_DAYS=90
SIMILAR_INVOICE_NUMBER_RATIO=0.8
VENDOR_SIMILARITY_THRESHOLD=0.6
MATH_TOLERANCE=0.05
PRICE_SPIKE_RATIO=2.5
PRICE_HISTORY_DAYS=365
PRICE_MIN_SAMPLES=3
TAX_TOLERANCE=0.05
AUTO_APPROVE_CONFIDENCE=90
CRITICAL_CONFIDENCE=70
STALE_INVOICE_DAYS=365
FUTURE_DATE_GRACE_DAYS=1

LOG_LEVEL=INFO
