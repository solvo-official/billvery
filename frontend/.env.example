# Copy to .env.local (git-ignored) and fill in.

# Where the dev/preview server forwards /api and /healthz. Use 127.0.0.1, not localhost:
# uvicorn binds IPv4 only and localhost can resolve to ::1 first.
AUDITOR_API_URL=http://127.0.0.1:8000

# Sent as "Authorization: Bearer <key>" on every proxied /api request. It stays in the dev
# server process; never rename it with a VITE_ prefix, which would compile it into the bundle.
AUDITOR_API_KEY=

# Leave AUDITOR_API_KEY empty to use Google sign-in locally instead (the backend then needs
# JWT_SECRET, GOOGLE_CLIENT_ID/SECRET and PUBLIC_URL=http://localhost:5173).

# Optional: call another origin directly instead of the proxy. Leave unset for Vercel, where
# the console and the API share one domain and every request is a relative /api/v1/... path.
# VITE_API_BASE_URL=https://audit.example.com
